# Copier ce fichier en .env pour les tests locaux
# (le fichier .env est dans .gitignore)
# Le script ne charge pas .env tout seul : node --env-file=.env veille-auto.mjs

# Clé API Anthropic, à récupérer sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle de chaque agent. Valeurs par défaut si non définis.
# VEILLE_MODEL_SCOUT=claude-sonnet-5-5
# VEILLE_MODEL_PLANNER=claude-opus-5-5
# VEILLE_MODEL_WRITER=claude-sonnet-5-5
# VEILLE_MODEL_OPTIMIZER=claude-haiku-5-5

# Optionnel : dossier de sortie. Défaut : ./output
# VEILLE_OUTPUT_DIR=./output
